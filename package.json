{
  "name": "pole003-sandbox",
  "private": true,
  "version": "0.16.0",
  "description": "Boîte à outils interne du Pôle 003 - Innovation (100 % local)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/verifier-build.ts",
    "build:beta": "tsc --noEmit -p tsconfig.json && vite build --mode beta && node scripts/verifier-build.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:securite": "node scripts/check-securite.ts",
    "veille:test": "node scripts/veille/diagnostic.ts",
    "veille:collecte": "node scripts/veille/collecte.ts",
    "veille:explorer-suivi": "node scripts/veille/explorer-suivi.ts",
    "veille:explorer-marches": "node scripts/veille/explorer-marches.ts",
    "marches:collecte": "node scripts/marches/collecte.ts",
    "fec:fictifs": "node scripts/generer-fec-fictifs.ts",
    "fec:gros": "node scripts/generer-fec-fictifs.ts --gros",
    "ca3:fictives": "node scripts/generer-ca3-fictives.ts",
    "ca3:navigateurs": "node scripts/generer-ca3-navigateurs.ts",
    "tva:fictifs": "node scripts/generer-tva-fictif.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "docx": "^9.9.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide": "^1.53.0",
    "pdfjs-dist": "^6.3.289"
  }
}
